{block content}
<p><a n:href="default"><i class="fa fa-arrow-left" aria-hidden="true"></i> API clients</a></p>
<form n:name="clientForm" class="panel form-horizontal">
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="panel-body">
        <div class="row">
            <div class="col-sm-6">
                <div class="form-group no-margin-hr">
                    <label n:name="name" class="control-label">Name <span class="text-danger">*</span></label>
                    <input n:name="name" class="form-control" autofocus>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group no-margin-hr">
                    <label n:name="limit" class="control-label">Requests per minute <span class="text-danger">*</span></label>
                    <input n:name="limit" class="form-control" min="1" max="100000">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-group no-margin-hr">
                    <label class="control-label">Scopes</label>
                    <div class="checkbox" n:foreach="$form['scopes']->getItems() as $scope => $label">
                        <label><input n:name="scopes:$scope" class="px"> <span class="lbl">{$label}</span></label>
                    </div>
                </div>
                <div class="checkbox">
                    <label><input n:name="is_active" class="px"> <span class="lbl">Active</span></label>
                </div>
            </div>
        </div>
    </div>
    <div class="panel-footer">
        <input n:name="save" class="btn btn-success button">
    </div>
</form>
{/block}
