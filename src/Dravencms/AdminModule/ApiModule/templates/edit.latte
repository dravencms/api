{block content}
<p><a n:href="default"><i class="fa fa-arrow-left" aria-hidden="true"></i> API clients</a></p>
<form n:name="clientForm" class="card">
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label n:name="name" class="form-label">Name <span class="text-danger">*</span></label>
                    <input n:name="name" class="form-control" autofocus>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="mb-3">
                    <label n:name="limit" class="form-label">Requests per minute <span class="text-danger">*</span></label>
                    <input n:name="limit" class="form-control" min="1" max="100000">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="mb-3">
                    <label class="form-label">Scopes</label>
                    <div class="form-check" n:foreach="$form['scopes']->getItems() as $scope => $label">
                        <label><input n:name="scopes:$scope" class="form-check-input"> <span class="form-check-label">{$label}</span></label>
                    </div>
                </div>
                <div class="form-check">
                    <label><input n:name="is_active" class="form-check-input"> <span class="form-check-label">Active</span></label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <input n:name="save" class="btn btn-success button">
    </div>
</form>
{/block}
